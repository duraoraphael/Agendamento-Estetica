# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Banco ÚNICO: PostgreSQL no Supabase (região São Paulo, sa-east-1). Copie as strings em Supabase > Connect.
# Se a senha tiver @ : / # ? % &, codifique-a (ex.: @ vira %40). Nunca coloque senhas reais neste arquivo de exemplo.
#
# Aplicação: "Transaction pooler" (porta 6543). O "?pgbouncer=true" é obrigatório para o Prisma.
DATABASE_URL="postgresql://postgres.[REF-DO-PROJETO]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrações e backup: "Session pooler" (porta 5432; funciona em redes só IPv4) ou "Direct connection".
# Só o Prisma CLI e os scripts de backup usam esta.
DIRECT_URL="postgresql://postgres.[REF-DO-PROJETO]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Autenticação (NextAuth)
# ---------------------------------------------------------------------------
# Gere um valor aleatório com: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Criptografia dos tokens do Google Agenda em repouso
# ---------------------------------------------------------------------------
# Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="coloque-uma-chave-base64-de-32-bytes-aqui"

# ---------------------------------------------------------------------------
# Primeira conta administrativa (usada apenas pelo script de seed)
# ---------------------------------------------------------------------------
ADMIN_NAME="Administradora"
ADMIN_EMAIL="admin@example.com"
ADMIN_PHONE="(11) 90000-0000"
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Integração com Google Agenda (opcional)
# ---------------------------------------------------------------------------
# Deixe em branco para manter o site funcionando apenas com a agenda interna.
# Veja no README como criar as credenciais no Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# ---------------------------------------------------------------------------
# Atrás de proxy/CDN (opcional)
# ---------------------------------------------------------------------------
# Número de proxies CONFIÁVEIS à frente da aplicação (ex.: 1). Habilita o limite de
# tentativas por IP usando X-Forwarded-For. Deixe em branco se o site NÃO está atrás
# de proxy confiável: o cabeçalho é forjável e, sem esta variável, é ignorado.
TRUSTED_PROXY_HOPS=

# ---------------------------------------------------------------------------
# Fila de sincronizacao com o Google Agenda (opcional)
# ---------------------------------------------------------------------------
# Servidor de processo fixo (npm start, VPS, Docker): o temporizador interno ja reenvia o que falhou,
# inclusive apos reinicios. "off" o desliga (so se um agendador externo fizer o trabalho).
# Na Vercel o worker por temporizador é desativado automaticamente; use a rota protegida com Vercel Cron ou
# outro agendador. Em outro servidor Node de processo fixo, defina "off" somente se houver agendador externo.
# GOOGLE_SYNC_WORKER=off
# Hospedagem serverless (sem processo continuo): defina um segredo forte (16+ caracteres; ex.: openssl rand -base64 32)
# e agende a cada 5 minutos:  GET /api/cron/google-sync  com  Authorization: Bearer <CRON_SECRET>.
# Sem o segredo a rota fica desativada (responde 401).
CRON_SECRET=
# SOMENTE desenvolvimento: Google Agenda simulado em memoria (nunca vale em producao). Veja o README.
# GOOGLE_CALENDAR_MOCK=1

# ---------------------------------------------------------------------------
# E-mail transacional (recuperacao de senha) — opcional
# ---------------------------------------------------------------------------
# "none" (padrao): nao envia nada; a recuperacao de senha fica inoperante ate configurar um provedor. O link de
# redefinicao NUNCA aparece na tela nem nos logs.
# "resend": envia pela API HTTPS do Resend (sem dependencia nova). Exige a chave e um remetente de dominio verificado.
# Para outro provedor (SMTP, SES...), implemente a interface em src/lib/mailer.ts. Veja o README.
MAIL_PROVIDER=none
# RESEND_API_KEY=
# MAIL_FROM="Garage Zero Zero <nao-responda@seudominio.com.br>"
# O link do e-mail usa NEXTAUTH_URL como base (nunca o cabecalho Host): configure-o com o endereco publico do site.

# ---------------------------------------------------------------------------
# Fotos dos servicos (Supabase Storage) — opcional ate o primeiro upload
# ---------------------------------------------------------------------------
# Sem estas duas variaveis o painel recusa o envio de fotos e o site mostra os placeholders (nada quebra).
# SUPABASE_URL: endereco do projeto (Project Settings > API > Project URL), ex.: https://abcdefgh.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: chave "service_role"/secret (Project Settings > API). SEGREDO: so no servidor, NUNCA com o
# prefixo NEXT_PUBLIC_ e nunca no navegador. Ela ignora o RLS: por isso todo envio/remocao passa pelo NextAuth (ADMIN).
# Crie o bucket publico uma vez com:  npm run storage:setup   (veja docs/fotos-servicos.md)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
