generator client {
  provider = "prisma-client-js"
}

// Banco ÚNICO: PostgreSQL (Supabase, região São Paulo).
//  - url:       conexão da aplicação (Transaction pooler, porta 6543, com ?pgbouncer=true).
//  - directUrl: conexão para migrações (Session pooler ou Direct, porta 5432); só o Prisma CLI a usa.
// Restrições que o Prisma não modela (sem sobreposição de horários, CHECKs, RLS) estão em prisma/migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Os valores abaixo são strings validadas/tipadas em TypeScript (veja src/lib/types.ts e validation.ts)
// e protegidas por CHECK no banco (prisma/migrations/*_integrity_constraints).
// Role: "CLIENTE" | "ADMIN"
// AppointmentStatus: "CONFIRMADA" | "CONCLUIDA" | "CANCELADA" | "FALTA"
// GoogleSyncStatus: "NAO_CONECTADO" | "PENDENTE" | "SINCRONIZADO" | "ERRO"

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  phone               String
  passwordHash        String?
  googleSubject       String?  @unique
  role                String   @default("CLIENTE")
  // Usado apenas pelo perfil ADMIN para saber quais agendamentos ainda não
  // foram "vistos" no painel (notificação de novo agendamento).
  notificationsSeenAt DateTime @default(now())
  // Sobe a cada redefinição/troca de senha. O JWT guarda a versão com que foi emitido; se não bater com a do banco, a
  // sessão deixa de valer (veja src/lib/session.ts). É o que "encerra as outras sessões" depois de uma troca de senha.
  sessionVersion      Int      @default(0)
  createdAt           DateTime @default(now())

  appointments        Appointment[]
  googleCalendarAccount GoogleCalendarAccount?
  vehicles            Vehicle[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
}

// Veículos da cliente (um por placa e por dona). A placa é gravada NORMALIZADA (maiúsculas, sem separador); o formato
// aceito (antigo AAA9999 e Mercosul AAA9A99) é garantido por CHECK na migração e por src/lib/validation.ts.
// O agendamento guarda uma CÓPIA (snapshot) dos dados: editar ou apagar o veículo nunca muda reservas já feitas.
model Vehicle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     String
  model     String
  // Categoria do veículo para o preço (HATCH | SEDA | SUV | PICAPE | VAN; veja src/lib/pricing.ts). Nulo = veículo
  // cadastrado antes do preço por tipo: continua válido e é completado na etapa do agendamento quando a chave está ligada.
  vehicleType String?
  plate     String
  year      Int?
  color     String?
  nickname  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@unique([userId, plate])
  @@index([userId])
}

// Recuperação de senha. Guarda SÓ o hash SHA-256 do token (o token em si só existe no e-mail enviado). Uso único,
// validade curta; pedir um novo link invalida os anteriores. Veja src/lib/password-reset.ts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Service {
  id              String   @id @default(cuid())
  name            String
  priceCents      Int
  durationMinutes Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments    Appointment[]
  images          ServiceImage[]
  prices          ServicePrice[]
}

// Preço do serviço por categoria de veículo (centavos). Só vale com SiteSettings.priceByVehicleType ligado; categoria
// sem linha usa o preço padrão do serviço. Veja src/lib/pricing.ts (regra) e pricing-data.ts (leitura sem cache).
model ServicePrice {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vehicleType String
  priceCents  Int

  @@unique([serviceId, vehicleType])
}

// Fotos dos serviços. Os bytes ficam no Supabase Storage (bucket público `service-images`); aqui só os metadados.
// A menor `position` é a capa (não há campo isCover). Teto de 6 por serviço garantido sob trava da linha do Service.
model ServiceImage {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  objectPath  String   @unique
  altText     String   @default("")
  position    Int
  width       Int
  height      Int
  sizeBytes   Int
  contentType String
  createdAt   DateTime @default(now())

  @@index([serviceId, position])
}

// Objetos do Storage que ficaram sem metadado (remoção que o Storage recusou). Limpos por `npm run storage:cleanup`.
// Guarda só o caminho aleatório gerado pelo servidor.
model StorageCleanup {
  id         String   @id @default(cuid())
  bucket     String
  objectPath String   @unique
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
}

// Expediente semanal. No máximo um registro por dia da semana (0=domingo .. 6=sábado).
model BusinessHours {
  id         String  @id @default(cuid())
  dayOfWeek  Int     @unique
  active     Boolean @default(false)
  startTime  String // "HH:mm"
  endTime    String // "HH:mm"
  breakStart String? // "HH:mm"
  breakEnd   String? // "HH:mm"
}

// Bloqueios pontuais: feriados, folgas, férias etc.
model BlockedPeriod {
  id        String   @id @default(cuid())
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([startAt, endAt])
}

model Appointment {
  id        String @id @default(cuid())
  clientId  String
  client    User   @relation(fields: [clientId], references: [id])
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  // Snapshot do serviço no momento da reserva: alterações futuras no
  // cadastro do serviço não devem afetar reservas já criadas.
  serviceName     String
  priceCents      Int
  durationMinutes Int

  // Veículo atendido. `vehicleId` é opcional por causa das reservas anteriores à Garage Zero Zero (sem veículo) e vira
  // nulo se a cliente apagar o veículo; os snapshots abaixo preservam marca, modelo e placa no histórico.
  vehicleId            String?
  vehicle              Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleBrandSnapshot String?
  vehicleModelSnapshot String?
  vehiclePlateSnapshot String?
  vehicleTypeSnapshot  String?
  // Observações da cliente (até 500 caracteres; texto puro, escapado na exibição).
  notes                String?

  startAt DateTime
  endAt   DateTime
  status  String @default("CONFIRMADA")

  googleEventId    String?
  googleSyncStatus String  @default("NAO_CONECTADO")
  googleSyncError  String?
  // Fila durável da sincronização (veja src/lib/google-sync-queue.ts): tentativas feitas e quando tentar de novo.
  googleSyncAttempts Int       @default(0)
  googleSyncNextAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@index([status])
  @@index([clientId])
  @@index([vehicleId])
  @@index([startAt, status])
  // Contagem de "novos agendamentos" do painel e fila de sincronização com o Google.
  @@index([createdAt])
  @@index([googleSyncStatus, googleSyncNextAt])
}

// Linha única usada como ponto de bloqueio explícito (lock) nas transações
// de criação de reserva, garantindo que duas reservas conflitantes nunca
// sejam confirmadas simultaneamente. Veja lib/booking.ts.
model BookingLock {
  id      Int @id @default(1)
  version Int @default(0)
}

model GoogleCalendarAccount {
  id           String   @id @default(cuid())
  adminUserId  String   @unique
  admin        User     @relation(fields: [adminUserId], references: [id])
  // Tokens armazenados criptografados (AES-256-GCM) — veja lib/crypto.ts
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  calendarId   String   @default("primary")
  connectedAt  DateTime @default(now())
  lastSyncError String?
}

// Contadores do limite de tentativas (login e cadastro). Ficam no banco para
// valer entre processos/instâncias. A chave guarda só um hash do e-mail/IP
// (veja src/lib/rate-limit.ts). Linhas expiradas são limpas oportunisticamente.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

// Trilha de auditoria (página /admin/logs). Só o servidor grava; a interface administrativa apenas lê.
// NUNCA guarda senha, token, cookie, chave, corpo de requisição, e-mail, nome ou celular: pessoas entram só como
// `actorId` (ID interno) ou `subjectHash` (hash curto do e-mail, para tentativas sem conta identificada).
// `actorId` não tem chave estrangeira de propósito: o histórico sobrevive à remoção da conta.
// Eventos repetitivos de falha/bloqueio são AGREGADOS (`count`) por chave e por hora, com teto de linhas distintas,
// para que um ataque não faça a tabela crescer sem limite (veja src/lib/audit-log.ts).
// Valores válidos de category/result: veja src/lib/audit-types.ts (e os CHECKs na migração).
model AuditLog {
  id          String   @id @default(cuid())
  // CADASTRO | LOGIN | LOGOUT | MARCACAO | ADMIN | INTEGRACAO
  category    String
  action      String
  // SUCESSO | FALHA | BLOQUEADO
  result      String
  actorId     String?
  subjectHash String?
  targetType  String?
  targetId    String?
  // Texto curto montado pelo código (nunca texto livre vindo de usuário sem limpeza).
  detail      String?
  count       Int      @default(1)
  // Chave de idempotência: a mesma operação repetida não gera uma segunda linha.
  dedupeKey   String?  @unique
  // Primeira ocorrência (linhas agregadas) e ocorrência mais recente (usada para ordenar e filtrar).
  createdAt   DateTime @default(now())
  occurredAt  DateTime @default(now())

  @@index([category, occurredAt])
  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([subjectHash])
  @@index([action, createdAt])
}

// Identidade e contatos do estúdio, editáveis pela administradora (Configurações). Linha única (id = 1);
// sem a linha, o site usa os padrões de src/lib/site.ts, então instalações anteriores seguem funcionando.
model SiteSettings {
  id            Int      @id @default(1)
  siteName      String   @default("")
  tagline       String   @default("")
  intro         String   @default("")
  phone         String   @default("")
  whatsapp      String   @default("")
  address       String   @default("")
  locationNotes String   @default("")
  instagramUrl  String   @default("")
  // 0 = sem logo enviada (usa a marca padrão). Incrementa a cada troca e serve de chave de cache da imagem.
  logoVersion   Int      @default(0)
  // "Cobrar por tipo de veículo": desligada = preço padrão do serviço; ligada = preço por categoria (ServicePrice).
  priceByVehicleType Boolean @default(false)
  updatedAt     DateTime @updatedAt
}

// Logo enviada. Fica no banco (e não no disco) para persistir em qualquer hospedagem, inclusive as de
// sistema de arquivos efêmero, e entrar no backup junto com o resto. Tabela separada: ler as
// configurações em toda página nunca carrega os bytes da imagem.
model SiteLogo {
  id          Int      @id @default(1)
  contentType String
  data        Bytes
  width       Int
  height      Int
  updatedAt   DateTime @updatedAt
}
